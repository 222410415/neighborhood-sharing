# Neighborhood Sharing and Rental Platform - environment template.
# Copy to .env and fill in. Never commit .env.
# Local development (Docker Compose) against a real Firebase project. Production
# on Google Cloud Run does not use this file (see docs/deployment.md).

# Firebase project id (must match the service-account key and the web config
# in apps/web/src/lib/firebase-client.ts)
FIREBASE_PROJECT_ID=neighborhood-sharing

# Absolute path to the service-account key JSON on this Mac, OUTSIDE this
# folder (Firebase console -> Project settings -> Service accounts). Docker
# mounts it read-only into the api and tools containers; it is never copied
# into an image. Never commit, upload or paste the key.
FIREBASE_KEY_FILE=

# AI (optional). Without a key, suggestions use the category fallback and the
# policy assistant shows the matching policy text. Enter your own key here.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
